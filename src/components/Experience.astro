---
import type { PortfolioContent } from '../data/types';
import SectionHeading from './SectionHeading.astro';
import { companyLogoSrcs } from '../data/logos';

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const { experience } = content;
const copy = content.copy.experience;

/** Same logo candidates as the Companies wall, so both always match. */
const companiesBySlug = new Map(content.site.companies.map((c) => [c.slug, c]));
const logoSrcs = (slug?: string) => {
  const company = slug ? companiesBySlug.get(slug) : undefined;
  return company ? companyLogoSrcs(company) : [];
};

/** Dates are language-neutral except for the open-ended "Present". */
const localizePeriod = (period: string) => period.replace('Present', copy.present);
/** Short label for a product link, e.g. "form.taxalign.com". */
const hostOf = (url: string) => new URL(url).host.replace(/^www\./, '');
---

<section id="experience" class="section">
  <div class="container-content">
    <SectionHeading eyebrow={copy.eyebrow} heading={copy.heading} />

    <ol class="relative space-y-8 border-l border-surface-border pl-6 sm:pl-8">
      {
        experience.map((role, i) => (
          <li class="reveal relative" style={`--reveal-delay: ${Math.min(i, 4) * 60}ms`}>
            <span class="absolute -left-[1.6rem] top-1.5 flex h-3.5 w-3.5 items-center justify-center sm:-left-[2.1rem]">
              <span class="h-3.5 w-3.5 rounded-full border-2 border-accent-400 bg-bg ring-4 ring-bg" />
            </span>

            <div class="card card-hover p-6">
              <div class="flex items-start gap-4">
                {role.companySlug && (
                  <img
                    src={logoSrcs(role.companySlug)[0]}
                    data-fallbacks={JSON.stringify(logoSrcs(role.companySlug).slice(1))}
                    alt={`${role.company} logo`}
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                    class="h-10 w-10 flex-none rounded-lg bg-white object-contain p-0.5 ring-1 ring-surface-border sm:h-12 sm:w-12"
                  />
                )}
                <div class="min-w-0 flex-1">
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                    <h3 class="text-lg font-semibold text-ink-strong">
                      {role.title} ·{' '}
                      {role.url ? (
                        <a href={role.url} target="_blank" rel="noopener noreferrer" class="text-accent-fg hover:text-accent-fg">
                          {role.company}
                        </a>
                      ) : (
                        <span class="text-accent-fg">{role.company}</span>
                      )}
                    </h3>
                    <span class="chip chip-accent shrink-0 self-start sm:self-auto">{localizePeriod(role.period)}</span>
                  </div>

                  <p class="mt-1 text-sm text-ink-faint">{role.location}</p>
                </div>
              </div>

              {role.roles && (
                <p class="mt-3 text-sm text-ink-muted">
                  <span class="font-medium text-ink-strong">{copy.rolesLabel}:</span> {role.roles.join(' · ')}
                </p>
              )}

              {role.product && (
                <p class="mt-1 text-sm text-ink-muted">
                  <span class="font-medium text-ink-strong">{copy.productLabel}:</span>{' '}
                  {role.productUrl ? (
                    <a href={role.productUrl} target="_blank" rel="noopener noreferrer" class="text-accent-fg hover:underline">
                      {role.product} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    role.product
                  )}
                </p>
              )}

              <p class="mt-3 text-sm leading-relaxed text-ink-muted">{role.summary}</p>

              {role.highlights.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {role.highlights.map((h) => (
                    <li class="flex gap-2.5 text-sm text-ink-muted">
                      <svg class="mt-1 h-3.5 w-3.5 flex-none text-accent-fg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                      </svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}

              {role.clientProjects.length > 0 && (
                <div class="mt-5">
                  <h4 class="mb-3 text-xs font-semibold uppercase tracking-wider text-accent-fg">{copy.clientProjectsLabel}</h4>
                  <ul class="space-y-4">
                    {role.clientProjects.map((project) => (
                      <li class="rounded-xl border border-surface-border bg-bg-soft/40 p-4 sm:p-5">
                        <div class="flex items-start gap-3">
                          {project.companySlug && (
                            <img
                              src={logoSrcs(project.companySlug)[0]}
                              data-fallbacks={JSON.stringify(logoSrcs(project.companySlug).slice(1))}
                              alt={`${project.client} logo`}
                              width="40"
                              height="40"
                              loading="lazy"
                              decoding="async"
                              class="h-9 w-9 flex-none rounded-lg bg-white object-contain p-0.5 ring-1 ring-surface-border sm:h-10 sm:w-10"
                            />
                          )}
                          <div class="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                            <h5 class="text-base font-semibold text-ink-strong">
                              {project.role} ·{' '}
                              {project.url ? (
                                <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-accent-fg hover:text-accent-fg">
                                  {project.client}
                                </a>
                              ) : (
                                <span class="text-accent-fg">{project.client}</span>
                              )}
                            </h5>
                            <span class="chip shrink-0 self-start sm:self-auto">{localizePeriod(project.period)}</span>
                          </div>
                        </div>

                        {project.productUrl && (
                          <p class="mt-2 text-sm text-ink-muted">
                            <span class="font-medium text-ink-strong">{copy.productLabel}:</span>{' '}
                            <a href={project.productUrl} target="_blank" rel="noopener noreferrer" class="text-accent-fg hover:underline">
                              {hostOf(project.productUrl)} <span aria-hidden="true">↗</span>
                            </a>
                          </p>
                        )}

                        <p class="mt-2 text-sm leading-relaxed text-ink-muted">{project.summary}</p>

                        <ul class="mt-3 space-y-2">
                          {project.highlights.map((h) => (
                            <li class="flex gap-2.5 text-sm text-ink-muted">
                              <svg class="mt-1 h-3.5 w-3.5 flex-none text-accent-fg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                              </svg>
                              <span>{h}</span>
                            </li>
                          ))}
                        </ul>

                        <ul class="mt-3 flex flex-wrap gap-2">
                          {project.tech.map((t) => (
                            <li class="chip">{t}</li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {role.tech.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {role.tech.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

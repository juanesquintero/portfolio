---
import type { PortfolioContent } from '../data/types';
import ThemeToggle from './ThemeToggle.astro';
import Flag from './Flag.astro';

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const { copy, locale, site } = content;
const nav = copy.nav;

// `spy` lists the section ids that highlight each link while in view.
const links = [
  { href: '#about', label: nav.about, spy: 'about' },
  { href: '#tech-stack', label: nav.skills, spy: 'tech-stack tools' },
  { href: '#experience', label: nav.experience, spy: 'experience education' },
  { href: '#companies', label: nav.companies, spy: 'companies' },
  { href: '#projects', label: nav.projects, spy: 'projects' },
  { href: '#contact', label: nav.contact, spy: 'contact' },
];

const enHref = '/';
const esHref = '/es/';
const homeHref = locale === 'es' ? esHref : enHref;
---

<header
  id="navbar"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-all duration-300"
>
  <nav class="container-content flex h-16 items-center justify-between gap-4" aria-label="Primary">
    <a href={homeHref} class="group flex items-center gap-2 font-bold text-ink-strong" aria-label={site.name}>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent-500/15 text-accent-fg ring-1 ring-accent-500/30 transition-colors group-hover:bg-accent-500/25">
        JQ
      </span>
      <span class="hidden whitespace-nowrap xl:inline">{site.name}</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-spy={link.spy}
              class="whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium text-ink-muted transition-colors hover:text-ink-strong"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex flex-none items-center gap-2">
      <!-- Language toggle -->
      <div
        class="flex items-center rounded-lg border border-surface-border bg-surface/60 p-0.5 text-xs font-semibold"
        role="group"
        aria-label="Language"
      >
        <a
          href={enHref}
          aria-current={locale === 'en' ? 'true' : undefined}
          class:list={[
            'inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 transition-colors',
            locale === 'en' ? 'bg-accent-500 text-white' : 'text-ink-muted hover:text-ink-strong',
          ]}
          hreflang="en"
          lang="en"
          aria-label="English"
          title="English"
          ><Flag country="us" class="h-3 w-[18px] lg:h-2.5 lg:w-[15px]" /><span class="hidden lg:inline">{copy.langToggle.en}</span></a
        >
        <a
          href={esHref}
          aria-current={locale === 'es' ? 'true' : undefined}
          class:list={[
            'inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 transition-colors',
            locale === 'es' ? 'bg-accent-500 text-white' : 'text-ink-muted hover:text-ink-strong',
          ]}
          hreflang="es"
          lang="es"
          aria-label="Español"
          title="Español"
          ><Flag country="co" class="h-3 w-[18px] lg:h-2.5 lg:w-[15px]" /><span class="hidden lg:inline">{copy.langToggle.es}</span></a
        >
      </div>

      <!-- Theme toggle -->
      <ThemeToggle labels={{ theme: nav.theme, auto: nav.themeAuto, light: nav.themeLight, dark: nav.themeDark }} />

      <!-- Download CV: icon only until there is room for the label -->
      <a
        href={site.cvPath}
        download
        class="btn btn-primary h-10 w-10 whitespace-nowrap p-0 text-xs xl:h-auto xl:w-auto xl:px-4 xl:py-2"
        aria-label={nav.downloadCv}
        title={nav.downloadCv}
      >
        <svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
        </svg>
        <span class="hidden xl:inline">{nav.downloadCv}</span>
      </a>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-lg border border-surface-border bg-surface/60 text-ink lg:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-surface-border bg-bg-soft/95 backdrop-blur lg:hidden"
  >
    <ul class="container-content flex flex-col gap-1 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink-muted hover:bg-surface hover:text-ink-strong"
              data-spy={link.spy}
              data-mobile-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={site.cvPath} download class="btn btn-primary mt-2 w-full">{nav.downloadCv}</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById('navbar');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Frosted background once scrolled
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 12) {
      nav.classList.add('border-surface-border', 'bg-bg-soft/80', 'backdrop-blur');
    } else {
      nav.classList.remove('border-surface-border', 'bg-bg-soft/80', 'backdrop-blur');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu open/close
  const closeMenu = () => {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  };
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('[data-mobile-link]').forEach((l) => l.addEventListener('click', closeMenu));

  // Scroll spy: highlight the nav link for the section currently in view.
  const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-spy]'));
  const spySections = Array.from(document.querySelectorAll<HTMLElement>('main > section[id]'));
  const ACTIVE = ['bg-accent-500/10', '!text-accent-fg'];

  const updateSpy = () => {
    // The section crossing a line a third of the way down the viewport is "current";
    // at the very bottom the last section wins even if it is short.
    // Never above where a section lands after a jump (heading just below the navbar).
    const line = Math.max(window.innerHeight / 3, 120);
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
    let current = '';
    for (const section of spySections) {
      if (section.getBoundingClientRect().top <= line) current = section.id;
    }
    if (atBottom && spySections.length) current = spySections[spySections.length - 1].id;

    spyLinks.forEach((link) => {
      const active = !!current && (link.dataset.spy ?? '').split(' ').includes(current);
      link.classList.toggle(ACTIVE[0], active);
      link.classList.toggle(ACTIVE[1], active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  let spyTicking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (spyTicking) return;
      spyTicking = true;
      requestAnimationFrame(() => {
        updateSpy();
        spyTicking = false;
      });
    },
    { passive: true }
  );
  window.addEventListener('resize', updateSpy);
  updateSpy();
</script>

---
// Small inline country flags for the language toggle (inline SVG renders
// consistently everywhere, unlike flag emoji on Windows).
interface Props {
  country: 'us' | 'co';
  class?: string;
}

const { country, class: className } = Astro.props;
---

<svg
  viewBox="0 0 30 20"
  class:list={['flex-none overflow-hidden rounded-[2px] ring-1 ring-black/10', className]}
  aria-hidden="true"
>
  {
    country === 'us' ? (
      <>
        <rect width="30" height="20" fill="#fff" />
        {[0, 2, 4, 6, 8, 10, 12].map((i) => (
          <rect y={(i * 20) / 13} width="30" height={20 / 13} fill="#B22234" />
        ))}
        <rect width="12" height={(20 / 13) * 7} fill="#3C3B6E" />
      </>
    ) : (
      <>
        <rect width="30" height="10" fill="#FCD116" />
        <rect y="10" width="30" height="5" fill="#003893" />
        <rect y="15" width="30" height="5" fill="#CE1126" />
      </>
    )
  }
</svg>
